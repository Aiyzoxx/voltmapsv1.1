{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022", "WebWorker"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "volt-presets.js",
    "volt-helpers.js",
    "fpsInjected.js",
    "volumeInjected.js",
    "securityInjected.js",
    "admin_entry.js",
    "types/**/*.d.ts"
  ]
}


