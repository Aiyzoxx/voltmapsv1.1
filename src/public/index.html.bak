    <a class="card" href="/houston.html"><h2>Houston Original</h2><p data-i18n="idx_desc_orig">Original map.</p></a>
    <a class="card" href="/iceland.html"><h2>Iceland Original</h2><p data-i18n="idx_desc_orig">Original map.</p></a>
    <a class="card" href="/london.html"><h2>London Original</h2><p data-i18n="idx_desc_orig">Original map.</p></a>
    <a class="card" href="/mexico.html"><h2>Mexico Original</h2><p data-i18n="idx_desc_orig">Original map.</p></a>
    <a class="card" href="/monaco.html"><h2>Monaco Original</h2><p data-i18n="idx_desc_orig">Original map.</p></a>
    <a class="card" href="/neworleans.html"><h2>New Orleans Original</h2><p data-i18n="idx_desc_orig">Original map.</p></a>
    <a class="card" href="/saintpetersburg.html"><h2>Saint Petersburg Original</h2><p data-i18n="idx_desc_orig">Original map.</p></a>
    <a class="card" href="/sanfrancisco.html"><h2>San Francisco Original</h2><p data-i18n="idx_desc_orig">Original map.</p></a>
    <a class="card" href="/winterholiday.html"><h2>Winter Holiday Original</h2><p data-i18n="idx_desc_orig">Original map.</p></a>
    <a class="card" href="/zurich.html"><h2>Zurich Original</h2><p data-i18n="idx_desc_orig">Original map.</p></a>
  </div>
  </div>

  <div class="category-section" id="cat-training" style="display: none;">
  <h2 class="category-title"><span data-i18n="idx_cat_train" style="color: inherit;">Map Training</span></h2>
  <div class="grid">
    <a class="card" href="/barcelona-training.html?mode=training"><h2>Barcelona Training</h2><p data-i18n="idx_desc_train">Map d'entrainement.</p></a>
    <a class="card" href="/beijing-training.html?mode=training"><h2>Beijing Training</h2><p data-i18n="idx_desc_train">Map d'entrainement.</p></a>
    <a class="card" href="/berlin-training.html?mode=training"><h2>Berlin Training</h2><p data-i18n="idx_desc_train">Map d'entrainement.</p></a>
    <a class="card" href="/buenosaires-training.html?mode=training"><h2>Buenos Aires Training</h2><p data-i18n="idx_desc_train">Map d'entrainement.</p></a>
    <a class="card" href="/havana-training.html?mode=training"><h2>Havana Training</h2><p data-i18n="idx_desc_train">Map d'entrainement.</p></a>
    <a class="card" href="/houston-training.html?mode=training"><h2>Houston Training</h2><p data-i18n="idx_desc_train">Map d'entrainement.</p></a>
    <a class="card" href="/iceland-training.html?mode=training"><h2>Iceland Training</h2><p data-i18n="idx_desc_train">Map d'entrainement.</p></a>
    <a class="card" href="/london-training.html?mode=training"><h2>London Training</h2><p data-i18n="idx_desc_train">Map d'entrainement.</p></a>
    <a class="card" href="/mexico-training.html?mode=training"><h2>Mexico Training</h2><p data-i18n="idx_desc_train">Map d'entrainement.</p></a>
    <a class="card" href="/monaco-training.html?mode=training"><h2>Monaco Training</h2><p data-i18n="idx_desc_train">Map d'entrainement.</p></a>
    <a class="card" href="/neworleans-training.html?mode=training"><h2>New Orleans Training</h2><p data-i18n="idx_desc_train">Map d'entrainement.</p></a>
    <a class="card" href="/saintpetersburg-training.html?mode=training"><h2>Saint Petersburg Training</h2><p data-i18n="idx_desc_train">Map d'entrainement.</p></a>
    <a class="card" href="/sanfrancisco-training.html?mode=training"><h2>San Francisco Training</h2><p data-i18n="idx_desc_train">Map d'entrainement.</p></a>
