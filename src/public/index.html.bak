  </div>

  <div class="category-section" id="cat-cheat" style="display: none;">
    <h2 class="category-title"><span data-i18n="idx_cat_cheat" style="color: inherit;">Map Cheat</span></h2>
    <div class="grid">
    <a class="card" href="/beijing-noimpo/">
      <h2>Beijing No Impossible</h2>
      <p data-i18n="idx_desc_noimpo">Impossible to get an impossible pattern.</p>
    </a>
    <a class="card" href="/beijing-reduced-impo/">
      <h2>Beijing reduced impo luck</h2>
      <p data-i18n="idx_desc_redimpo">Reduced chance of getting an impossible pattern.</p>
    </a>
  </div>
  </div>

  <footer>
    Volt X AIyzoxX <span>·</span> Subway Surfers Training Maps
  </footer>

  <script>
    function showCategory(categoryId, btn) {
      // Update active tab
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');

      // Show/Hide sections
      document.querySelectorAll('.category-section').forEach(section => {
        if (categoryId === 'all') {
          section.style.display = 'flex';
        } else {
          if (section.id === 'cat-' + categoryId) {
            section.style.display = 'flex';
          } else {
            section.style.display = 'none';
          }
        }
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.getElementById('nocoinToggle');
      
      // Default state: if not explicitly set to 'false', it's enabled
      if (localStorage.getItem('nocoinExtensionEnabled') === 'false') {
        toggle.checked = false;
      } else {
        toggle.checked = true;
        localStorage.setItem('nocoinExtensionEnabled', 'true');
      }
      
      toggle.addEventListener('change', (e) => {
        localStorage.setItem('nocoinExtensionEnabled', e.target.checked ? 'true' : 'false');
      });

      // Language Overlay Logic
      if (!localStorage.getItem('langChosen')) {
        document.getElementById('lang-overlay').style.display = 'flex';
      }
    });

    window.selectLang = function(lang) {
      if (window.i18n) {
        window.i18n.setLang(lang);
      } else {
        localStorage.setItem('lang', lang);
      }
      localStorage.setItem('langChosen', 'true');
      document.getElementById('lang-overlay').style.display = 'none';
    };
  </script>
  <script src="js/i18n.js"></script>
</body>
</html>

